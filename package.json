{
  "name": "radiology-cv-studio",
  "version": "1.0.0",
  "description": "Production-minded, bilingual (Arabic RTL / English LTR), multi-user CV and professional profile builder for radiology and medical-imaging professionals",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings src/server.js",
    "migrate": "node --no-warnings scripts/migrate.js",
    "seed": "node --no-warnings scripts/seed-runtime.js",
    "backup": "node --no-warnings scripts/backup-restore.js backup",
    "restore": "node --no-warnings scripts/backup-restore.js restore",
    "test": "node --no-warnings --test tests/acceptance.test.js",
    "build": "node --no-warnings scripts/verify-build.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true
}
