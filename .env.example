# ============================================================================
# Radiology CV Studio — Environment Variables (.env.example)
# ============================================================================
# Copy this file to .env for local or production configuration.
# NEVER commit real secrets, API keys, passwords, or private tokens to Git.

# Application Public Metadata
NEXT_PUBLIC_APP_NAME="Radiology CV Studio"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV=development

# Site Creator & Support Attribution (Configurable)
ADMIN_CONTACT_NAME="Abd-el-Rahman Adel Teba"
ADMIN_CONTACT_EMAIL="frp.nasr@gmail.com"
ADMIN_CONTACT_PHONE="01091874291"
ADMIN_PHONE_PUBLIC_VISIBILITY="registered_only"

# Optional WhatsApp Support Link & Cloud API (Disabled until verified & configured)
ADMIN_WHATSAPP_ENABLED=false
ADMIN_WHATSAPP_E164="+201091874291"
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Email Notifications (Disabled until SMTP / Provider is configured and tested)
ADMIN_EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER="none"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""

# Authentication Providers (Setup Required for external OAuth / SMS OTP)
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

AUTH_PHONE_OTP_ENABLED=false
SMS_PROVIDER="none"
SMS_API_KEY=""
SMS_SENDER_ID=""

# Database & Security (Server-side only — never expose to browser)
DATABASE_PATH="./runtime-data/radiology_cv_studio.sqlite"
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_64_BYTE_HEX_IN_PRODUCTION"
PRIVATE_SEED_FILE="/home/user/uploaded_files/Genspark_Radiology_CV_Builder_Master_Prompt-1.md"

# Optional AI Writing Assistant Provider (Server-side only; falls back to deterministic truth-preserving engine)
AI_PROVIDER_ENABLED=false
OPENAI_API_KEY=""

# Quotas & Security Policies
MAX_IMAGE_MB=10
MAX_DOCUMENT_MB=20
MAX_PROFILE_UPLOAD_MB=100
SHARE_LINK_DEFAULT_EXPIRY_HOURS=24
MALWARE_SCANNER_ENABLED=false
ERROR_REPORTING_ENABLED=false
